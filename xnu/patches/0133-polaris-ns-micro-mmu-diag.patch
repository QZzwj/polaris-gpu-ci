+/*
+ * 0133 bits 1/2: ACTLR + micro-MMU.  QCOM requires the micro-MMU to be
+ * idle before context-bank state changes and resumed after them.
+ */
+static bool
+pg_smmu_micro_mmu_halt(const char *tag)
+{
+	uint32_t ctrl;
+	unsigned int i;
+
+	if (pg_smmu_regs == NULL) {
+		return false;
+	}
+	ctrl = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_IMPL_DEF1 + PG_SMMU_MICRO_MMU_CTRL);
+	printf("POLARIS PWR: SMMU micro %s halt before=0x%08x\n", tag, ctrl);
+	pg_wr32(pg_smmu_regs, PG_SMMU_IMPL_DEF1 + PG_SMMU_MICRO_MMU_CTRL,
+	    ctrl | PG_SMMU_MICRO_MMU_HALT, 3);
+	__sync_synchronize();
+	for (i = 0; i < PG_SMMU_MICRO_MMU_POLL_US; i++) {
+		ctrl = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_IMPL_DEF1 + PG_SMMU_MICRO_MMU_CTRL);
+		if ((ctrl & PG_SMMU_MICRO_MMU_IDLE) != 0) {
+			break;
+		}
+		DELAY(1);
+	}
+	printf("POLARIS PWR: SMMU micro %s halt after=0x%08x idle=%u "
+	    "polls=%u\n", tag, ctrl,
+	    (ctrl & PG_SMMU_MICRO_MMU_IDLE) ? 1u : 0u, i);
+	return (ctrl & PG_SMMU_MICRO_MMU_IDLE) != 0;
+}
+
+static void
+pg_smmu_micro_mmu_resume(const char *tag)
+{
+	uint32_t ctrl;
+
+	if (pg_smmu_regs == NULL) {
+		return;
+	}
+	ctrl = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_IMPL_DEF1 + PG_SMMU_MICRO_MMU_CTRL);
+	printf("POLARIS PWR: SMMU micro %s resume before=0x%08x\n", tag, ctrl);
+	pg_wr32(pg_smmu_regs, PG_SMMU_IMPL_DEF1 + PG_SMMU_MICRO_MMU_CTRL,
+	    ctrl & ~PG_SMMU_MICRO_MMU_HALT, 3);
+	__sync_synchronize();
+	printf("POLARIS PWR: SMMU micro %s resume after=0x%08x\n", tag,
+	    pg_rd32(pg_smmu_regs,
+	    PG_SMMU_IMPL_DEF1 + PG_SMMU_MICRO_MMU_CTRL));
+}
+
+/*
+ * 0133 bit 4: the firmware fault address 0x06f8fbc4 is not a literal in
+ * a630_gmu.bin, so it is probably loaded from DTCM.  Dump the first 1 KiB
+ * of the CM3 data TCM to expose an uninitialised pointer or table entry.
+ */
+static void
+pg_gmu_dtcm_dump(const char *tag)
+{
+	uint32_t i, v, nonzero = 0;
+	uint32_t base = (uint32_t)PG_GMU_CM3_DTCM_START;
+
+	if (pg_gmu_regs == NULL) {
+		return;
+	}
+	printf("POLARIS PWR: GMU DTCM 0133 dump %s\n", tag);
+	for (i = 0; i < 256u; i += 8u) {
+		printf("POLARIS PWR: GMU DTCM %s [%03x] "
+		    "%08x %08x %08x %08x %08x %08x %08x %08x\n", tag, i,
+		    pg_rd32(pg_gmu_regs, base + (i + 0u) * 4u),
+		    pg_rd32(pg_gmu_regs, base + (i + 1u) * 4u),
+		    pg_rd32(pg_gmu_regs, base + (i + 2u) * 4u),
+		    pg_rd32(pg_gmu_regs, base + (i + 3u) * 4u),
+		    pg_rd32(pg_gmu_regs, base + (i + 4u) * 4u),
+		    pg_rd32(pg_gmu_regs, base + (i + 5u) * 4u),
+		    pg_rd32(pg_gmu_regs, base + (i + 6u) * 4u),
+		    pg_rd32(pg_gmu_regs, base + (i + 7u) * 4u));
+	}
+	for (i = 0; i < 256u; i++) {
+		v = pg_rd32(pg_gmu_regs, base + i * 4u);
+		if (v != 0) {
+			nonzero++;
+		}
+	}
+	printf("POLARIS PWR: GMU DTCM 0133 %s nonzero=%u/256\n", tag,
+	    nonzero);
+}
