+/*
+ * 0133 bit 4: unconditional state dump.  pg_smmu_fault_probe() skips banks
+ * that have no live fault, which can hide a stale ACTLR or a FAR_HI value
+ * left by an earlier read.  Print every bank and the micro-MMU control.
+ */
+static void
+pg_smmu_all_cb_dump(const char *tag)
+{
+	unsigned int i;
+	uint32_t sctlr, fsr, far_lo, far_hi, actlr, fsynr0, frsynra;
+	uint64_t far64;
+
+	if (pg_smmu_regs == NULL) {
+		printf("POLARIS PWR: SMMU 0133 dump %s no map\n", tag);
+		return;
+	}
+	printf("POLARIS PWR: SMMU 0133 dump %s IDR0=0x%08x IDR1=0x%08x "
+	    "IDR2=0x%08x micro=0x%08x\n", tag,
+	    pg_rd32(pg_smmu_regs, PG_SMMU_IDR0),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_IDR1),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_IDR2),
+	    pg_rd32(pg_smmu_regs,
+	    PG_SMMU_IMPL_DEF1 + PG_SMMU_MICRO_MMU_CTRL));
+	for (i = 0; i <= PG_SMMU_MAX_LEVEL; i++) {
+		sctlr = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_SCTLR));
+		fsr = pg_rd32(pg_smmu_regs, PG_SMMU_CB(i, PG_SMMU_CB_FSR));
+		far_lo = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_FAR_LO));
+		far_hi = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_FAR_HI));
+		far64 = pg_rd64(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_FAR_LO));
+		actlr = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_ACTLR));
+		fsynr0 = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_FSYNR0));
+		frsynra = pg_rd32(pg_smmu_regs, PG_SMMU_CBFRSYNRA(i));
+		printf("POLARIS PWR: SMMU 0133 CB%u SCTLR=0x%08x FSR=0x%08x "
+		    "FAR_LO=0x%08x FAR_HI=0x%08x FAR64=0x%llx ACTLR=0x%08x "
+		    "FSYNR0=0x%08x CBFRSYNRA=0x%08x\n", i, sctlr, fsr,
+		    far_lo, far_hi, far64, actlr, fsynr0, frsynra);
+	}
+}
