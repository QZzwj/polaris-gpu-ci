+/*
+ * 0133: bit 19 of an AArch32 short-descriptor section is NS.  The GMU data
+ * path is a non-secure master while the SMMU register writes are owned by
+ * the secure monitor.  A secure (NS=0) leaf makes the real CM3 walk fault
+ * with FSR.TF while ATS1PR, which does not carry the stream security state,
+ * succeeds.  Keep the old value available through polaris0133 bit 0 so one
+ * kernel can test both.
+ */
+#define PG_SMMU_S1_DESC_NS          (1u << 19)
+
+#define PG_SMMU_CB_ACTLR            0x004u
+#define PG_SMMU_CB_RESUME           0x008u
+#define PG_SMMU_CB_RESUME_TERMINATE (1u << 0)
+#define PG_SMMU_ACTLR_QCOM_NSH      0x70000000u
+
+/*
+ * 0133: QCOM's micro-MMU sits at implementation-defined page 1, six pages
+ * above the SMMU base.  HALT_REQ must be raised and IDLE polled before any
+ * context-bank state is changed, exactly as qsmmuv2_device_reset() does.
+ */
+#define PG_SMMU_IMPL_DEF1           0x6000u
+#define PG_SMMU_MICRO_MMU_CTRL      0x000u
+#define PG_SMMU_MICRO_MMU_HALT      (1u << 2)
+#define PG_SMMU_MICRO_MMU_IDLE      (1u << 3)
+#define PG_SMMU_MICRO_MMU_POLL_US   30000u
+
+/*
+ * 0133 bit 5: alternative GMU-visible HFI base.  0x60000000 maps onto the
+ * same low-DRAM 1 MiB window that contains the HFI reservation; because a
+ * short-descriptor section is 1 MiB aligned, the table itself sits at
+ * 0x60020000 (PA 0x8c420000).
+ */
+#define PG_0133_HFI_VA_BASE         0x60000000u
+#define PG_0133_HFI_PA_BASE         0x8c400000u
+#define PG_0133_HFI_OFFSET          0x00020000u
+
+/* polaris0133 boot-arg bits. */
+#define PG_0133_NS_DESC             (1u << 0)
+#define PG_0133_CB_ACTLR            (1u << 1)
+#define PG_0133_MICRO_MMU           (1u << 2)
+#define PG_0133_CB_RESUME_RETRY     (1u << 3)
+#define PG_0133_DIAG                (1u << 4)
+#define PG_0133_HFI_BASE            (1u << 5)
