+{
+	uint32_t pdc_en = 0xffffffffu;
+	uint32_t cb = 0;
+
+	printf("POLARIS PWR: HFI snapshot %s\n", tag);
+	if (pg_gmu_regs == NULL) {
+		printf("POLARIS PWR: HFI snapshot %s: no GMU map\n", tag);
+		return;
+	}
+	printf("POLARIS PWR: HFI snap ctrl status=0x%08x init=0x%08x "
+	    "ver=0x%08x qtbl_addr=0x%08x qtbl_info=0x%08x sfr=0x%08x\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_HFI_CTRL_STATUS),
+	    pg_rd32(pg_gmu_regs, PG_GMU_HFI_CTRL_INIT),
+	    pg_rd32(pg_gmu_regs, PG_GMU_HFI_VERSION_INFO),
+	    pg_rd32(pg_gmu_regs, PG_GMU_HFI_QTBL_ADDR),
+	    pg_rd32(pg_gmu_regs, PG_GMU_HFI_QTBL_INFO),
+	    pg_rd32(pg_gmu_regs, PG_GMU_HFI_SFR_ADDR));
+	printf("POLARIS PWR: HFI snap intr info=0x%08x mask=0x%08x "
+	    "ao=0x%08x ao_mask=0x%08x fence=0x%08x\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_INFO),
+	    pg_rd32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_MASK),
+	    pg_rd32(pg_gmu_regs, PG_GMU_AO_HOST_INTR_STATUS),
+	    pg_rd32(pg_gmu_regs, PG_GMU_AO_HOST_INTR_MASK),
+	    pg_rd32(pg_gmu_regs, PG_GMU_AHB_FENCE_STATUS));
+	printf("POLARIS PWR: HFI snap cm3 init=0x%08x busy=0x%08x "
+	    "cfg=0x%08x general7=0x%08x pwrmsg=0x%08x pwrresp=0x%08x\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_CM3_FW_INIT_RESULT),
+	    pg_rd32(pg_gmu_regs, PG_GMU_CM3_FW_BUSY),
+	    pg_rd32(pg_gmu_regs, PG_GMU_CM3_CFG),
+	    pg_rd32(pg_gmu_regs, PG_GMU_GENERAL_7),
+	    pg_rd32(pg_gmu_regs, PG_GMU_PWR_COL_CP_MSG),
+	    pg_rd32(pg_gmu_regs, PG_GMU_PWR_COL_CP_RESP));
+	if (pg_pdc_regs != NULL) {
+		pdc_en = pg_rd32(pg_pdc_regs, PG_PDC_GPU_ENABLE_PDC);
+	}
+	printf("POLARIS PWR: HFI snap rscc ack=0x%08x seq_busy=0x%08x "
+	    "pdc_en=0x%08x\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_CONTROL_ACK),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_SEQ_BUSY_DRV0), pdc_en);
+	if (pg_smmu_regs != NULL) {
+		printf("POLARIS PWR: HFI snap smmu sCR0=0x%08x sACR=0x%08x "
+		    "GFSR=0x%08x S2CR3=0x%08x S2CR4=0x%08x SMR3=0x%08x "
+		    "SMR4=0x%08x\n",
+		    pg_rd32(pg_smmu_regs, 0x000u),
+		    pg_rd32(pg_smmu_regs, PG_SMMU_sACR),
+		    pg_rd32(pg_smmu_regs, PG_SMMU_GFSR),
+		    pg_rd32(pg_smmu_regs, PG_SMMU_S2CR(3)),
+		    pg_rd32(pg_smmu_regs, PG_SMMU_S2CR(4)),
+		    pg_rd32(pg_smmu_regs, PG_SMMU_SMR(3)),
+		    pg_rd32(pg_smmu_regs, PG_SMMU_SMR(4)));
+		if (pg_smmu_s1_cbndx >= 0) {
+			cb = (uint32_t)pg_smmu_s1_cbndx;
+			printf("POLARIS PWR: HFI snap CB%u SCTLR=0x%08x "
+			    "TTBR0=0x%08x TTBCR=0x%08x FSR=0x%08x "
+			    "FAR=0x%08x\n", cb,
+			    pg_rd32(pg_smmu_regs,
+			    PG_SMMU_CB(cb, PG_SMMU_CB_SCTLR)),
+			    pg_rd32(pg_smmu_regs,
+			    PG_SMMU_CB(cb, PG_SMMU_CB_TTBR0_LO)),
+			    pg_rd32(pg_smmu_regs,
+			    PG_SMMU_CB(cb, PG_SMMU_CB_TTBCR)),
+			    pg_rd32(pg_smmu_regs,
+			    PG_SMMU_CB(cb, PG_SMMU_CB_FSR)),
+			    pg_rd32(pg_smmu_regs,
+			    PG_SMMU_CB(cb, PG_SMMU_CB_FAR_LO)));
+		}
+	}
+}
