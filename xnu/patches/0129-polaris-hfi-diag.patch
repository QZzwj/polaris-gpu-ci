+/*
+ * 0129: the 0128a run proved that the CM3 reaches its 0xBABEFACE entry but
+ * never sets HFI_CTRL_STATUS bit 0. The firmware debug-log area and the DBG
+ * queue are the only places that can explain why from the firmware side, so
+ * dump both before any fault state is cleared or the CM3 is touched again.
+ */
+static void
+pg_hfi_log_dump(const char *why)
+{
+	volatile uint32_t *log;
+	unsigned int i, pos, start, n;
+	unsigned int dwords = 512u;
+	char buf[81];
+
+	if (!pg_hfi.ready || pg_hfi.va == 0) {
+		printf("POLARIS PWR: HFI log dump %s: no table\n", why);
+		return;
+	}
+	pg_hfi_flush();
+	log = (volatile uint32_t *)(pg_hfi.va + PG_HFI_TABLE_SIZE);
+	printf("POLARIS PWR: HFI log dump %s pa=0x%llx dwords=%u\n", why,
+	    (unsigned long long)(pg_hfi.pa + PG_HFI_TABLE_SIZE), dwords);
+	for (i = 0; i < dwords; i += 8u) {
+		printf("POLARIS PWR: HFI log[%03x] %08x %08x %08x %08x "
+		    "%08x %08x %08x %08x\n", i,
+		    log[i + 0u], log[i + 1u], log[i + 2u], log[i + 3u],
+		    log[i + 4u], log[i + 5u], log[i + 6u], log[i + 7u]);
+	}
+	printf("POLARIS PWR: HFI log ascii %s\n", why);
+	pos = 0;
+	while (pos < PG_HFI_DBG_SIZE) {
+		n = 0;
+		while (pos < PG_HFI_DBG_SIZE &&
+		    (((volatile uint8_t *)log)[pos] < 0x20u ||
+		    ((volatile uint8_t *)log)[pos] > 0x7eu)) {
+			pos++;
+		}
+		start = pos;
+		while (pos < PG_HFI_DBG_SIZE &&
+		    ((volatile uint8_t *)log)[pos] >= 0x20u &&
+		    ((volatile uint8_t *)log)[pos] <= 0x7eu) {
+			if (n + 1u < sizeof(buf)) {
+				buf[n++] =
+				    (char)((volatile uint8_t *)log)[pos];
+			}
+			pos++;
+		}
+		if (n >= 4u && pos - start >= 4u) {
+			buf[n] = '\0';
+			printf("POLARIS PWR: HFI log ascii %s off=0x%04x "
+			    "\"%s\"\n", why, start, buf);
+		}
+	}
+}
+
+static void
+pg_hfi_debug_queue_dump(const char *why)
+{
+	volatile uint32_t *table = (volatile uint32_t *)pg_hfi.va;
+	volatile uint32_t *q;
+	volatile uint8_t *b;
+	unsigned int i, pos, start, n;
+	unsigned int dwords = 256u;
+	uint32_t off = PG_HFI_Q0_OFFSET + PG_HFI_DBG_Q * PG_HFI_Q_STRIDE;
+	char buf[81];
+
+	if (!pg_hfi.ready || pg_hfi.va == 0 || table == 0) {
+		printf("POLARIS PWR: HFI dbgq dump %s: no table\n", why);
+		return;
+	}
+	pg_hfi_flush();
+	q = (volatile uint32_t *)(pg_hfi.va + off);
+	printf("POLARIS PWR: HFI dbgq dump %s off=0x%x pa=0x%llx "
+	    "rd=%u wr=%u dwords=%u\n", why, off,
+	    (unsigned long long)(pg_hfi.pa + off),
+	    table[PG_HFI_HDR_DWORDS + 2u * PG_HFI_QHDR_DWORDS + 10u],
+	    table[PG_HFI_HDR_DWORDS + 2u * PG_HFI_QHDR_DWORDS + 11u],
+	    dwords);
+	for (i = 0; i < dwords; i += 8u) {
+		printf("POLARIS PWR: HFI dbgq[%03x] %08x %08x %08x %08x "
+		    "%08x %08x %08x %08x\n", i,
+		    q[i + 0u], q[i + 1u], q[i + 2u], q[i + 3u],
+		    q[i + 4u], q[i + 5u], q[i + 6u], q[i + 7u]);
+	}
+	printf("POLARIS PWR: HFI dbgq ascii %s\n", why);
+	b = (volatile uint8_t *)q;
+	pos = 0;
+	while (pos < 1024u) {
+		n = 0;
+		while (pos < 1024u &&
+		    (b[pos] < 0x20u || b[pos] > 0x7eu)) {
+			pos++;
+		}
+		start = pos;
+		while (pos < 1024u && b[pos] >= 0x20u && b[pos] <= 0x7eu) {
+			if (n + 1u < sizeof(buf)) {
+				buf[n++] = (char)b[pos];
+			}
+			pos++;
+		}
+		if (n >= 4u && pos - start >= 4u) {
+			buf[n] = '\0';
+			printf("POLARIS PWR: HFI dbgq ascii %s off=0x%04x "
+			    "\"%s\"\n", why, start, buf);
+		}
+	}
+}
