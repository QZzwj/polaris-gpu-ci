+static void
+pg_smmu_reset_all(const char *tag)
+{
+	uint32_t acr, scr0, gfsr, status;
+	unsigned int i;
+
+	if (pg_smmu_regs == NULL) {
+		return;
+	}
+	acr = pg_rd32(pg_smmu_regs, PG_SMMU_sACR);
+	if ((acr & PG_SMMU_ACR_CACHE_LOCK) != 0) {
+		pg_wr32(pg_smmu_regs, PG_SMMU_sACR,
+		    acr & ~PG_SMMU_ACR_CACHE_LOCK, 3);
+	}
+	for (i = 0; i <= PG_SMMU_MAX_LEVEL; i++) {
+		pg_wr32(pg_smmu_regs, PG_SMMU_CB(i, PG_SMMU_CB_SCTLR), 0, 3);
+		pg_wr32(pg_smmu_regs, PG_SMMU_CB(i, PG_SMMU_CB_FSR),
+		    0xffffffffu, 3);
+	}
+	__sync_synchronize();
+	gfsr = pg_rd32(pg_smmu_regs, PG_SMMU_GFSR);
+	pg_wr32(pg_smmu_regs, PG_SMMU_GFSR, gfsr, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_TLBIALLH, 0, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_TLBIALLNSNH, 0, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_STLBGSYNC, 0, 3);
+	status = 0;
+	for (i = 0; i < PG_SMMU_TLB_POLL_US / 1000u; i++) {
+		status = pg_rd32(pg_smmu_regs, PG_SMMU_STLBGSTATUS);
+		if ((status & 1u) == 0) {
+			break;
+		}
+		DELAY(1);
+	}
+	scr0 = pg_rd32(pg_smmu_regs, PG_SMMU_sCR0);
+	/* GFRE|GFIE|GCFGFRE|GCFGFIE */
+	scr0 |= (1u << 1) | (1u << 2) | (1u << 4) | (1u << 5);
+	/* VMIDPNE|PTM */
+	scr0 |= (1u << 11) | (1u << 12);
+	/* CLIENTPD|USFCFG|FB off, BSU=0 */
+	scr0 &= ~((1u << 0) | (1u << 10) | (1u << 13));
+	scr0 &= ~(3u << 14);
+	/* SHCFG=NSH */
+	scr0 &= ~(3u << 22);
+	scr0 |= (3u << 22);
+	pg_wr32(pg_smmu_regs, PG_SMMU_sCR0, scr0, 3);
+	__sync_synchronize();
+	printf("POLARIS PWR: SMMU 0134 reset %s sACR=0x%08x sCR0=0x%08x "
+	    "GFSR=0x%08x tlb=0x%08x\n", tag,
+	    pg_rd32(pg_smmu_regs, PG_SMMU_sACR),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_sCR0),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_GFSR), status);
+	for (i = 0; i <= PG_SMMU_MAX_LEVEL; i++) {
+		printf("POLARIS PWR: SMMU 0134 reset %s CB%u SCTLR=0x%08x "
+		    "FSR=0x%08x\n", tag, i,
+		    pg_rd32(pg_smmu_regs, PG_SMMU_CB(i, PG_SMMU_CB_SCTLR)),
+		    pg_rd32(pg_smmu_regs, PG_SMMU_CB(i, PG_SMMU_CB_FSR)));
+	}
+}
