+#define PG_GX_GFX3D_M      (0x1024u - PG_GPUCC_PAGE_OFFSET)
+#define PG_GX_GFX3D_N      (0x1028u - PG_GPUCC_PAGE_OFFSET)
+#define PG_GX_GFX3D_D      (0x102cu - PG_GPUCC_PAGE_OFFSET)
+#define PG_GX_GFX3D_CBCR   (0x1054u - PG_GPUCC_PAGE_OFFSET)
