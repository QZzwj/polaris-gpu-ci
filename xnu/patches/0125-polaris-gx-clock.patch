+/*
+ * 0125: enable the GX core clock before CM3 release. 0124 showed the GMU
+ * CM3 alive but the gfx rail ack stuck at 0 and SPTPRAC status 0x94, whose
+ * bit 7 is GX_CLK_OFF (bit 6, GX_GDSC_POWER_OFF, is already clear). The
+ * vendor order in kgsl gmu_start() is GDSC, all GPUCC clocks including
+ * gpu_cc_gx_gfx3d_clk, then CM3 release.
+ *
+ * Try the branch bit alone first; the bootloader may have left the RCG
+ * parented. If the branch stays halted, program the RCG from GPLL0_OUT_MAIN
+ * (parent 5, divider 1), which is always available, and retry the branch.
+ * GX GDSC/clamp are left alone because the rail already reads powered.
+ */
+static int
+pg_gx_clk_on(void)
+{
+	uint32_t cbcr, cmd, cfg, value;
+	uint32_t cbcr_saved, cmd_saved, cfg_saved;
+	unsigned int i;
+
+	cbcr = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CBCR);
+	cmd = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD);
+	cfg = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CFG);
+	printf("POLARIS PWR: GX clk enter cbcr=0x%08x cmd=0x%08x cfg=0x%08x "
+	    "gdscr=0x%08x clamp=0x%08x m=%u n=%u d=%u\n",
+	    cbcr, cmd, cfg,
+	    pg_rd32(pg_cx_regs, PG_GX_GDSCR),
+	    pg_rd32(pg_cx_regs, PG_GX_CLAMP_IO),
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_M),
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_N),
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_D));
+	if ((cbcr & PG_CBCR_CLK_OFF) == 0) {
+		printf("POLARIS PWR: GX clk already on; CBCR=0x%08x\n", cbcr);
+		return 1;
+	}
+
+	cbcr_saved = cbcr;
+	cmd_saved = cmd;
+	cfg_saved = cfg;
+
+	/* Minimal step: branch enable only. */
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CBCR, cbcr | PG_CBCR_ENABLE, 3);
+	for (i = 0; i < PG_POLL_US; i++) {
+		cbcr = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CBCR);
+		if ((cbcr & PG_CBCR_CLK_OFF) == 0) {
+			break;
+		}
+		DELAY(1);
+	}
+	if (i < PG_POLL_US) {
+		printf("POLARIS PWR: GX clk branch on (minimal); CBCR=0x%08x\n",
+		    cbcr);
+		return 1;
+	}
+	printf("POLARIS PWR: GX clk branch halted after %u polls; "
+	    "programming RCG (cmd=0x%08x cfg=0x%08x)\n", i,
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD),
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_CFG));
+
+	/* Root request; wait for ROOT_OFF to drop. */
+	cmd = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CMD, cmd | PG_RCG_CMD_ROOT_EN, 3);
+	for (i = 0; i < PG_RCG_POLL_US; i++) {
+		if ((pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD) &
+		    PG_RCG_CMD_ROOT_OFF) == 0) {
+			break;
+		}
+		DELAY(1);
+	}
+	if (i == PG_RCG_POLL_US) {
+		goto fail;
+	}
+
+	/* Integer divider mode: M/N/D = 0. */
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_M, 0, 3);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_N, 0, 3);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_D, 0, 3);
+
+	/* Parent 5 = GPLL0_OUT_MAIN, source divider 1. */
+	value = (5u << 8);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CFG, value, 3);
+	if (pg_rd32(pg_cx_regs, PG_GX_GFX3D_CFG) != value) {
+		goto fail;
+	}
+
+	/* Commit and wait for UPDATE to self-clear. */
+	cmd = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CMD,
+	    cmd | PG_RCG_CMD_ROOT_EN | PG_RCG_CMD_UPDATE, 3);
+	for (i = 0; i < PG_RCG_POLL_US; i++) {
+		cmd = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD);
+		if ((cmd & (PG_RCG_CMD_UPDATE | PG_RCG_CMD_DIRTY_CFG)) == 0) {
+			break;
+		}
+		DELAY(1);
+	}
+	if (i == PG_RCG_POLL_US) {
+		goto fail;
+	}
+
+	/* Retry the branch with a valid parent. */
+	cbcr = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CBCR);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CBCR, cbcr | PG_CBCR_ENABLE, 3);
+	for (i = 0; i < PG_POLL_US; i++) {
+		cbcr = pg_rd32(pg_cx_regs, PG_GX_GFX3D_CBCR);
+		if ((cbcr & PG_CBCR_CLK_OFF) == 0) {
+			break;
+		}
+		DELAY(1);
+	}
+	if (i == PG_POLL_US) {
+		goto fail;
+	}
+	printf("POLARIS PWR: GX clk on; CBCR=0x%08x cmd=0x%08x cfg=0x%08x\n",
+	    cbcr, pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD),
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_CFG));
+	return 1;
+
+fail:
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CBCR, cbcr_saved, 3);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CFG, cfg_saved, 3);
+	pg_wr32(pg_cx_regs, PG_GX_GFX3D_CMD, cmd_saved | PG_RCG_CMD_UPDATE, 3);
+	printf("POLARIS PWR: GX clk enable failed; restored "
+	    "(cbcr=0x%08x cmd=0x%08x cfg=0x%08x)\n",
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_CBCR),
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_CMD),
+	    pg_rd32(pg_cx_regs, PG_GX_GFX3D_CFG));
+	return 0;
+}
