 	}
 
-	pg_clk_owned = 1;
 	printf("POLARIS PWR: gmu clock source root on; cfg=0x%08x\n",
 	    pg_rd32(pg_cx_regs, PG_GMU_CLK_CFG));
 	printf("POLARIS PWR: gmu branch enabled; CBCR=0x%08x\n",
 	    pg_rd32(pg_cx_regs, PG_CX_GMU_CBCR));
+
+	/*
+	 * 0125: the GMU branch is up; now give the GX domain its core clock
+	 * before CM3 release (kgsl gmu_start order). A failure here rolls the
+	 * GMU clock back rather than leaving a half-configured domain.
+	 */
+	if (!pg_gx_clk_on()) {
+		pg_clocks_rollback(pg_cbcr_saved, pg_cmd_saved, pg_cfg_saved);
+		pg_pll1_exit();
+		return 0;
+	}
+	pg_clk_owned = 1;
 	return 1;
 }
 
