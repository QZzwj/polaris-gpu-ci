+/*
+ * 0125: GX core clock (vendor gpu_cc_gx_gfx3d_clk).
+ *   gfx3d_clk_src cmd_rcgr = 0x101c (cmd 0x101c, cfg 0x1020, m/n/d 0x1024..)
