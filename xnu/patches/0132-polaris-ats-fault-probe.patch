+/*
+ * 0132: SMMUv2 TLBIALLNSNH/sTLBGSYNC are command registers; the command
+ * is a zero write, not a one write.  Poll sTLBGSTATUS.GSACTIVE with a
+ * bounded budget and report a timeout instead of spinning forever.
+ */
+static bool
+pg_smmu_tlb_invalidate_global(const char *tag)
+{
+	uint32_t status = 0;
+	unsigned int i;
+
+	pg_wr32(pg_smmu_regs, PG_SMMU_TLBIALLNSNH, 0, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_STLBGSYNC, 0, 3);
+	for (i = 0; i < PG_SMMU_TLB_POLL_US / 1000u; i++) {
+		status = pg_rd32(pg_smmu_regs, PG_SMMU_STLBGSTATUS);
+		if ((status & 1u) == 0) {
+			break;
+		}
+		DELAY(1000);
+	}
+	printf("POLARIS PWR: SMMU TLB global %s status=0x%08x %s\n",
+	    tag, status, (status & 1u) != 0 ? "timeout" : "ok");
+	return (status & 1u) == 0;
+}
+
+/*
+ * 0132: invalidate only the selected context bank, then wait for
+ * TLBSTATUS.SACTIVE to clear.  This is the vendor non-errata path.
+ */
+static bool
+pg_smmu_tlb_invalidate_cb(unsigned int cb, const char *tag)
+{
+	uint32_t status = 0;
+	unsigned int i;
+
+	pg_wr32(pg_smmu_regs, PG_SMMU_CB(cb, PG_SMMU_CB_S1_TLBIALL), 0, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_CB(cb, PG_SMMU_CB_TLBSYNC), 0, 3);
+	for (i = 0; i < PG_SMMU_TLB_POLL_US / 1000u; i++) {
+		status = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(cb, PG_SMMU_CB_TLBSTATUS));
+		if ((status & PG_SMMU_CB_TLBSTATUS_SACTIVE) == 0) {
+			break;
+		}
+		DELAY(1000);
+	}
+	printf("POLARIS PWR: SMMU TLB CB%u %s status=0x%08x %s\n",
+	    cb, tag, status,
+	    (status & PG_SMMU_CB_TLBSTATUS_SACTIVE) != 0 ? "timeout" : "ok");
+	return (status & PG_SMMU_CB_TLBSTATUS_SACTIVE) == 0;
+}
