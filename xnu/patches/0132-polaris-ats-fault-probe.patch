+/*
+ * 0132: ask the SMMU itself to walk the stage-1 table for one page.  The
+ * result is independent of the CM3 traffic path, so it separates a bad
+ * mapping from a stream/attribute problem.  Snapshot the fault registers
+ * first, then clear only the stale FSR value, as the vendor does.  A
+ * timeout is explicitly inconclusive: QCOM's ATS path also halts the
+ * micro-MMU, which this bring-up does not implement yet.
+ */
+static bool
+pg_smmu_ats1pr_probe(unsigned int cb, uint32_t va, const char *tag)
+{
+	uint64_t expected = 0, par, par_before;
+	uint32_t desc = 0, fsr_before, fsr_after, fsynr0, frsynra;
+	uint32_t far_lo, far_hi, atsr, idr0, idx, page, sid;
+	uint64_t far_before, far_after;
+	unsigned int i;
+	bool timed_out = false;
+
+	if (pg_smmu_regs == NULL || pg_smmu_s1_pt == NULL ||
+	    cb > PG_SMMU_MAX_LEVEL) {
+		printf("POLARIS PWR: SMMU ATS1PR %s CB%u unavailable\n",
+		    tag, cb);
+		return false;
+	}
+	if (pg_smmu_ats_timed_out) {
+		printf("POLARIS PWR: SMMU ATS1PR %s CB%u skipped after "
+		    "earlier timeout\n", tag, cb);
+		return false;
+	}
+
+	page = va & ~0xfffu;
+	idx = page >> 20;
+	desc = pg_smmu_s1_pt[idx];
+	if ((desc & 3u) == 2u) {
+		expected = (uint64_t)(desc & 0xfff00000u) |
+		    (page & 0xfffffu);
+	}
+	fsr_before = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FSR));
+	far_lo = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FAR_LO));
+	far_hi = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FAR_HI));
+	far_before = (uint64_t)far_lo | ((uint64_t)far_hi << 32);
+	fsynr0 = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FSYNR0));
+	frsynra = pg_rd32(pg_smmu_regs, PG_SMMU_CBFRSYNRA(cb));
+	par_before = pg_rd64(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_PAR_LO));
+	atsr = pg_rd32(pg_smmu_regs, PG_SMMU_CB(cb, PG_SMMU_CB_ATSR));
+	idr0 = pg_rd32(pg_smmu_regs, PG_SMMU_IDR0);
+	sid = frsynra & PG_SMMU_CBFRSYNRA_SID_MASK;
+	printf("POLARIS PWR: SMMU ATS1PR %s CB%u pre va=0x%08x "
+	    "page=0x%08x desc=0x%08x expected=0x%llx atosns=%u "
+	    "FSR=0x%08x FAR=0x%llx FSYNR0=0x%08x wnr=%u sid=0x%04x "
+	    "PAR=0x%llx ATSR=0x%08x\n", tag, cb, va, page, desc, expected,
+	    (idr0 >> 26) & 1u, fsr_before, far_before, fsynr0,
+	    (fsynr0 & PG_SMMU_CB_FSYNR0_WNR) ? 1u : 0u, sid, par_before,
+	    atsr);
+
+	/* Clear the stale fault value so ATS can report a fresh fault. */
+	pg_wr32(pg_smmu_regs, PG_SMMU_CB(cb, PG_SMMU_CB_FSR),
+	    fsr_before, 3);
+	__sync_synchronize();
+	pg_wr64(pg_smmu_regs, PG_SMMU_CB(cb, PG_SMMU_CB_ATS1PR), page);
+	__sync_synchronize();
+	for (i = 0; i < PG_SMMU_ATS_POLL_US; i++) {
+		atsr = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(cb, PG_SMMU_CB_ATSR));
+		if ((atsr & PG_SMMU_CB_ATSR_ACTIVE) == 0) {
+			break;
 		}
+		DELAY(1);
+	}
+	if ((atsr & PG_SMMU_CB_ATSR_ACTIVE) != 0) {
+		timed_out = true;
+		pg_smmu_ats_timed_out = true;
+	}
+
+	par = pg_rd64(pg_smmu_regs, PG_SMMU_CB(cb, PG_SMMU_CB_PAR_LO));
+	fsr_after = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FSR));
+	far_lo = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FAR_LO));
+	far_hi = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FAR_HI));
+	far_after = (uint64_t)far_lo | ((uint64_t)far_hi << 32);
+	fsynr0 = pg_rd32(pg_smmu_regs,
+	    PG_SMMU_CB(cb, PG_SMMU_CB_FSYNR0));
+	frsynra = pg_rd32(pg_smmu_regs, PG_SMMU_CBFRSYNRA(cb));
+	sid = frsynra & PG_SMMU_CBFRSYNRA_SID_MASK;
+	printf("POLARIS PWR: SMMU ATS1PR %s CB%u post va=0x%08x "
+	    "PAR=0x%llx pa=0x%llx ATSR=0x%08x FSR=0x%08x FAR=0x%llx "
+	    "FSYNR0=0x%08x wnr=%u sid=0x%04x par_unchanged=%u\n",
+	    tag, cb, va, par, par & PG_SMMU_CB_PAR_PA_MASK, atsr,
+	    fsr_after, far_after, fsynr0,
+	    (fsynr0 & PG_SMMU_CB_FSYNR0_WNR) ? 1u : 0u, sid,
+	    par == par_before ? 1u : 0u);
+	if (timed_out) {
+		printf("POLARIS PWR: SMMU ATS1PR %s CB%u TIMEOUT "
+		    "va=0x%08x atsr=0x%08x; inconclusive (ATS may require "
+		    "QCOM halt/resume)\n", tag, cb, va, atsr);
+		return false;
+	}
+	if ((par & PG_SMMU_CB_PAR_F) != 0) {
+		printf("POLARIS PWR: SMMU ATS1PR %s CB%u FAULT va=0x%08x "
+		    "PAR=0x%llx expected=0x%llx\n", tag, cb, va, par,
+		    expected);
+		return true;
 	}
+	printf("POLARIS PWR: SMMU ATS1PR %s CB%u ok va=0x%08x "
+	    "pa=0x%llx expected=0x%llx match=%s\n", tag, cb, va,
+	    par & PG_SMMU_CB_PAR_PA_MASK, expected,
+	    (par & PG_SMMU_CB_PAR_PA_MASK) == expected ? "yes" : "no");
+	return true;
 }
 
