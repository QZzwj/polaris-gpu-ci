+/*
+ * 0132: ATS1PR is a single 64-bit register on SMMUv2 and must be written
+ * with one store.  PAR and the prefetch-address registers are read as two
+ * 32-bit halves because this mapping is a volatile u32 view.
+ */
+static inline uint64_t
+pg_rd64(volatile uint32_t *base, uint32_t off)
+{
+	uint64_t lo = pg_rd32(base, off);
+	uint64_t hi = pg_rd32(base, off + 4u);
+
+	return lo | (hi << 32);
+}
+
+static inline void
+pg_wr64(volatile uint32_t *base, uint32_t off, uint64_t value)
+{
+	*(volatile uint64_t *)((volatile char *)base + off) = value;
+}
