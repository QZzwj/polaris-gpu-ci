+/*
+ * 0124: mainline a6xx_gmu_rpmh_init(). The GMU firmware votes through the
+ * RSC/PDC sequencer as soon as it starts; without this programming the first
+ * RPMh transaction faults the CM3. The sequence is copied from
+ * a6xx_gmu_rpmh_init() for a630 (pdc_address_offset 0x30080).
+ */
+static bool
+pg_gmu_rpmh_init(void)
+{
+	static const uint32_t rscc_seq[5] = {
+		0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u,
+		0x0020e8a8u
+	};
+	static const uint32_t pdc_seq[5] = {
+		0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u,
+		0x002081fcu
+	};
+	uint32_t status0_before, seq_busy_before, ack_before;
+	uint32_t pdc_en_before;
+	unsigned int i;
+
+	if (!pg_pdc_map()) {
+		return false;
+	}
+	status0_before = pg_rd32(pg_gmu_regs, PG_GMU_RSCC_RSC_STATUS0_DRV0);
+	seq_busy_before = pg_rd32(pg_gmu_regs, PG_GMU_RSCC_SEQ_BUSY_DRV0);
+	ack_before = pg_rd32(pg_gmu_regs, PG_GMU_RSCC_CONTROL_ACK);
+	pdc_en_before = pg_rd32(pg_pdc_regs, PG_PDC_GPU_ENABLE_PDC);
+	printf("POLARIS PWR: RPMh init before status0=0x%08x seq_busy=0x%08x "
+	    "ack=0x%08x pdc_en=0x%08x\n", status0_before, seq_busy_before,
+	    ack_before, pdc_en_before);
+
+	/* Disable SDE clock gating and set up the RSC/PDC handshake. */
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_RSC_STATUS0_DRV0, 1u << 24, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_PDC_SLAVE_ID_DRV0, 1, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_HIDDEN_TCS_CMD0_DATA, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_HIDDEN_TCS_CMD0_ADDR, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_HIDDEN_TCS_CMD1_DATA, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_HIDDEN_TCS_CMD1_ADDR, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_HIDDEN_TCS_CMD2_DATA, 0x80000000u, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_HIDDEN_TCS_CMD2_ADDR, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_OVERRIDE_START_ADDR, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_PDC_SEQ_START_ADDR, 0x4520u, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_PDC_MATCH_VALUE_LO, 0x4510u, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_RSCC_PDC_MATCH_VALUE_HI, 0x4514u, 3);
+
+	for (i = 0; i < 5u; i++) {
+		pg_wr32(pg_gmu_regs, PG_GMU_RSCC_SEQ_MEM_0_DRV0 + i * 4u,
+		    rscc_seq[i], 3);
+	}
+	pg_sync_checkpoint("rpmh-rscc-done");
+
+	/* Load the PDC sequencer uCode and its TCS commands. */
+	for (i = 0; i < 5u; i++) {
+		pg_wr32(pg_pdc_regs, PG_PDC_GPU_SEQ_MEM_0 + i * 4u,
+		    pdc_seq[i], 3);
+	}
+	pg_sync_checkpoint("rpmh-pdc-seq");
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD_ENABLE_BANK, 7, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK, 0, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CONTROL, 0, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_MSGID, 0x10108u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_ADDR, 0x30010u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_DATA, 1, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_MSGID + 16u, 0x10108u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_ADDR + 16u, 0x30000u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_DATA + 16u, 0, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_MSGID + 32u, 0x10108u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_ADDR + 32u,
+	    PG_PDC_GPU_A630_ADDRESS_OFFSET, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS1_CMD0_DATA + 32u, 0, 3);
+	pg_sync_checkpoint("rpmh-tcs1");
+
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD_ENABLE_BANK, 7, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK, 0, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CONTROL, 0, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_MSGID, 0x10108u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_ADDR, 0x30010u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_DATA, 2, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_MSGID + 16u, 0x10108u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_ADDR + 16u, 0x30000u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_DATA + 16u, 3, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_MSGID + 32u, 0x10108u, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_ADDR + 32u,
+	    PG_PDC_GPU_A630_ADDRESS_OFFSET, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_TCS3_CMD0_DATA + 32u, 3, 3);
+	pg_sync_checkpoint("rpmh-tcs3");
+
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_SEQ_START_ADDR, 0, 3);
+	pg_wr32(pg_pdc_regs, PG_PDC_GPU_ENABLE_PDC, 0x80000001u, 3);
+	__sync_synchronize();
+	pg_sync_checkpoint("rpmh-enabled");
+
+	printf("POLARIS PWR: RPMh init done status0=0x%08x slave=0x%08x "
+	    "seq_start=0x%08x match=0x%08x/0x%08x seq_mem0=0x%08x "
+	    "seq_busy=0x%08x ack=0x%08x pdc_en=0x%08x tcs1=0x%08x "
+	    "tcs3=0x%08x\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_RSC_STATUS0_DRV0),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_PDC_SLAVE_ID_DRV0),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_PDC_SEQ_START_ADDR),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_PDC_MATCH_VALUE_LO),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_PDC_MATCH_VALUE_HI),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_SEQ_MEM_0_DRV0),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_SEQ_BUSY_DRV0),
+	    pg_rd32(pg_gmu_regs, PG_GMU_RSCC_CONTROL_ACK),
+	    pg_rd32(pg_pdc_regs, PG_PDC_GPU_ENABLE_PDC),
+	    pg_rd32(pg_pdc_regs, PG_PDC_GPU_TCS1_CONTROL),
+	    pg_rd32(pg_pdc_regs, PG_PDC_GPU_TCS3_CONTROL));
+	return true;
+}
