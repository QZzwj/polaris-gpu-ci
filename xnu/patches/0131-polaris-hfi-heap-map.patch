  * secure monitor turns a BYPASS S2CR store into FAULT (TYPE 1 -> 2), so the
@@ -1978,7 +2030,8 @@ pg_hfi_smmu_stage1(void)
 	vm_offset_t va = 0;
 	uint64_t pt_pa, win_pa;
 	volatile uint32_t *pt;
-	uint32_t i, idx, first, alias_first, cbndx = 0, s2cr3, s2cr4, val;
