 			    0xfff00000u) | PG_SMMU_S1_DESC_FLAGS;
 		}
 	}
+	/*
+	 * 0131: diagnostic mapping for the firmware heap window.  Every
+	 * one of the 16 sections aliases the same free low-DRAM MiB at
+	 * 0x8c400000; only the page at +0x8f000 is filled with a sentinel.
+	 * If the firmware writes VA 0x06f8fbc4 the SMMU must no longer
+	 * report a translation fault, and the host can see the write.
+	 */
+	heap_first = PG_GMU_HEAP_VA_BASE >> 20;
+	if (heap_first + PG_GMU_HEAP_SECTIONS <=
+	    PG_SMMU_S1_PT_SIZE / 4u) {
