+/*
+ * 0131 diagnostic window.  The CM3 faults at VA 0x06f8fbc4 while HFI
+ * CTRL_INIT is running.  That address is inside the GMU's 2 GiB view of
+ * physical 0x86f8fbc4 (the same bit-31 truncation that produced the
+ * 0x0c420008 fault in 0129).  Map the whole 0x06f00000-0x06ffffff
+ * window onto the free low-DRAM MiB at 0x8c400000 so a firmware write
+ * cannot escape into another subsystem.  A host-visible page inside
+ * that MiB is filled with a sentinel before the CM3 is released.
+ */
+#define PG_GMU_HEAP_VA_BASE         0x06f00000u
+#define PG_GMU_HEAP_SECTIONS        16u
+#define PG_GMU_HEAP_WINDOW_PA       0x8c400000u
+#define PG_GMU_HEAP_SCRATCH_PA      0x8c48f000ull
+#define PG_GMU_HEAP_SCRATCH_SIZE    0x1000u
+#define PG_GMU_HEAP_SCRATCH_FILL    0xdeadbeefu
+
