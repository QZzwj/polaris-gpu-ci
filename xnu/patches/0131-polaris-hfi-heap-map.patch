+/*
+ * 0131: sample the SMMU fault state at each pre-HFI checkpoint.  The
+ * 0130 ring only proved that CB4 FSR was zero at s1-done; it did not
+ * show when the 0x06f8fbc4 fault appeared.  Reading GFSR/GFAR and each
+ * context bank is safe here: these are the same registers already read
+ * by stage-1 setup (IDR3 is deliberately never touched).
+ */
+static void
+pg_smmu_fault_probe(const char *tag)
+{
+	unsigned int i;
+	uint32_t fsr, far, sctlr;
+
+	if (pg_smmu_regs == NULL) {
+		printf("POLARIS PWR: SMMU fault probe %s no map\n", tag);
+		return;
+	}
+	printf("POLARIS PWR: SMMU fault probe %s GFSR=0x%08x GFAR=0x%08x\n",
+	    tag, pg_rd32(pg_smmu_regs, PG_SMMU_GFSR),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_GFAR));
+	for (i = 0; i <= PG_SMMU_MAX_LEVEL; i++) {
+		fsr = pg_rd32(pg_smmu_regs, PG_SMMU_CB(i, PG_SMMU_CB_FSR));
+		far = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_FAR_LO));
+		sctlr = pg_rd32(pg_smmu_regs,
+		    PG_SMMU_CB(i, PG_SMMU_CB_SCTLR));
+		if (fsr != 0 || far != 0 || (int)i == pg_smmu_s1_cbndx) {
+			printf("POLARIS PWR: SMMU fault probe %s CB%u "
+			    "SCTLR=0x%08x FSR=0x%08x FAR=0x%08x\n", tag, i,
+			    sctlr, fsr, far);
+		}
+	}
+}
