+			pt[heap_first + i] =
+			    (PG_GMU_HEAP_WINDOW_PA & 0xfff00000u) |
+			    PG_SMMU_S1_DESC_FLAGS;
+		}
+	}
 	__sync_synchronize();
 	pg_sync_checkpoint("s1-pt-filled");
 	printf("POLARIS PWR: SMMU S1 pt pa=0x%llx win=0x%08x first=%u "
@@ -2059,6 +2128,10 @@ pg_hfi_smmu_stage1(void)
 		    "desc[%u]=0x%08x\n", alias_first << 20, alias_first,
 		    alias_first, pt[alias_first]);
 	}
+	printf("POLARIS PWR: SMMU S1 heap va=0x%08x sz=0x%08x pa=0x%08x "
+	    "desc[0x%x]=0x%08x\n", PG_GMU_HEAP_VA_BASE,
+	    PG_GMU_HEAP_SECTIONS * PG_SMMU_S1_SECTION_SIZE,
+	    PG_GMU_HEAP_WINDOW_PA, heap_first, pt[heap_first]);
 
 	/* Dump every candidate bank before choosing one. */
 	pg_sync_checkpoint("s1-cb-probe");
@@ -2166,9 +2239,78 @@ pg_hfi_smmu_stage1(void)
 	    pg_rd32(pg_smmu_regs, PG_SMMU_CB(cbndx, PG_SMMU_CB_FSR)),
 	    pg_rd32(pg_smmu_regs, PG_SMMU_CB(cbndx, PG_SMMU_CB_FAR_LO)));
 	pg_sync_checkpoint("s1-done");
+	pg_smmu_fault_probe("s1-done");
 	return true;
 }
 
+/*
+ * 0131: map and fill the host side of the diagnostic GMU heap page.
+ * This page is the physical target of VA 0x06f8f000-0x06f8ffff in the
+ * stage-1 table built above.  A firmware write at 0x06f8fbc4 therefore
+ * appears at offset 0xbc4 of this mapping.
+ */
+static bool
+pg_heap_scratch_prepare(void)
+{
+	vm_offset_t va;
+	uint32_t i, bad = 0;
+
+	if (pg_heap_scratch != NULL) {
+		return true;
+	}
+	va = ml_io_map((vm_offset_t)PG_GMU_HEAP_SCRATCH_PA,
+	    PG_GMU_HEAP_SCRATCH_SIZE);
+	if (va == 0) {
+		printf("POLARIS PWR: GMU heap scratch map failed pa=0x%llx\n",
+		    PG_GMU_HEAP_SCRATCH_PA);
+		return false;
+	}
+	pg_heap_scratch = (volatile uint32_t *)va;
+	for (i = 0; i < PG_GMU_HEAP_SCRATCH_SIZE / 4u; i++) {
+		pg_heap_scratch[i] = PG_GMU_HEAP_SCRATCH_FILL;
+	}
+	__sync_synchronize();
+	for (i = 0; i < PG_GMU_HEAP_SCRATCH_SIZE / 4u; i++) {
+		if (pg_heap_scratch[i] != PG_GMU_HEAP_SCRATCH_FILL) {
+			bad++;
+		}
+	}
+	printf("POLARIS PWR: GMU heap scratch pa=0x%llx size=0x%x "
+	    "verify=%s bad=%u\n", PG_GMU_HEAP_SCRATCH_PA,
+	    PG_GMU_HEAP_SCRATCH_SIZE, bad == 0 ? "ok" : "mismatch", bad);
+	return bad == 0;
+}
+
+static void
+pg_heap_scratch_dump(const char *tag)
+{
+	uint32_t i, changed = 0;
+	uint32_t sentinel;
+
+	if (pg_heap_scratch == NULL) {
+		printf("POLARIS PWR: HFI snap heap %s no map\n", tag);
+		return;
+	}
+	__sync_synchronize();
+	for (i = 0; i < PG_GMU_HEAP_SCRATCH_SIZE / 4u; i++) {
+		if (pg_heap_scratch[i] != PG_GMU_HEAP_SCRATCH_FILL) {
+			changed++;
+		}
+	}
+	sentinel = pg_heap_scratch[0xbc4u / 4u];
+	printf("POLARIS PWR: HFI snap heap %s pa=0x%llx changed=%u/%u "
+	    "far_off=0xbc4 value=0x%08x\n", tag, PG_GMU_HEAP_SCRATCH_PA,
+	    changed, PG_GMU_HEAP_SCRATCH_SIZE / 4u, sentinel);
+	for (i = 0; i < 16u; i += 8u) {
+		printf("POLARIS PWR: HFI snap heap[%03x] %08x %08x %08x "
+		    "%08x %08x %08x %08x %08x\n", i,
+		    pg_heap_scratch[i + 0u], pg_heap_scratch[i + 1u],
+		    pg_heap_scratch[i + 2u], pg_heap_scratch[i + 3u],
+		    pg_heap_scratch[i + 4u], pg_heap_scratch[i + 5u],
+		    pg_heap_scratch[i + 6u], pg_heap_scratch[i + 7u]);
+	}
+}
